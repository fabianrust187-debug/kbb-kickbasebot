# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Application / Client ID from Discord Developer Portal
CLIENT_ID=your_discord_application_client_id_here

# Optional: Guild ID for fast slash-command registration during development
# If empty, commands are registered globally and can take longer to appear.
GUILD_ID=your_discord_server_id_here

# Optional: default accent color for embeds
KBB_EMBED_COLOR=0x00ff66
