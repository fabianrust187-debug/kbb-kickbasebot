# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Application / Client ID from Discord Developer Portal
CLIENT_ID=your_discord_application_client_id_here

# Optional: Guild ID for fast slash-command registration during development
# If empty, commands are registered globally and can take longer to appear.
GUILD_ID=your_discord_server_id_here

# Optional: default accent color for embeds
KBB_EMBED_COLOR=0x00ff66

# Dedicated channel for experimental/new feature output
KBB_TEST_CHANNEL_ID=1522249317656690929

# Top-5 configuration
TOP5_CHANNEL_ID=your_top5_channel_id_here
TOP5_MANAGER_TARGET=14

# Kickbase read-only data integration
# Competition 1 is Bundesliga.
KICKBASE_COMPETITION_ID=1
KICKBASE_LEAGUE_NAME=187 KICKBASEBANDE

# Optional but recommended if known; avoids resolving the league by name.
KICKBASE_LEAGUE_ID=

# Authentication option A: pre-obtained Bearer token.
# Never commit a real token to GitHub; set it only in your hosting environment.
KICKBASE_TOKEN=

# Authentication option B: automatic login/refresh.
# If these are set, the bot can refresh an expired token automatically.
# Store them only in your hosting provider's secret/environment variables.
KICKBASE_EMAIL=
KICKBASE_PASSWORD=

# Optional API timeout in milliseconds
KICKBASE_API_TIMEOUT_MS=10000
